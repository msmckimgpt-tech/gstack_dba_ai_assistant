@echo off
setlocal EnableDelayedExpansion

REM ============================================================
REM  mysql-ai Internal Root CA - trust installer (Windows)
REM  feature-0006 TASK-0298 / TASK-0299 (encoding fix).
REM  Single self-contained file (certificate embedded).
REM  ASCII-only + CRLF, no chcp -- avoids cmd.exe codepage seek bug.
REM  Requires Administrator -- auto-elevates.
REM ============================================================

net session >nul 2>&1
if errorlevel 1 (
  echo Requesting administrator privileges...
  powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)

set "FP_DISPLAY=__ROOTCA_SHA256__"
set "FP_HEX=__ROOTCA_SHA256_HEX__"
set "CRT=%TEMP%\mysql-ai-rootCA.crt"

echo(
echo ===========================================================
echo   mysql-ai Internal Root CA - trust installer
echo ===========================================================
echo   Certificate fingerprint (SHA-256):
echo     %FP_DISPLAY%
echo(
echo   ^> Confirm this matches the fingerprint your admin shared.
echo   ^> If it differs, close now and contact your admin (MITM risk).
echo(
pause

REM --- decode embedded certificate to a temp file ---
powershell -NoProfile -Command "[IO.File]::WriteAllBytes('%CRT%',[Convert]::FromBase64String('__ROOTCA_B64__'))"
if not exist "%CRT%" (
  echo [ERROR] Failed to extract certificate.
  pause
  exit /b 1
)

REM --- re-verify fingerprint before trusting ---
REM  certificate DER SHA-256 (matches openssl -fingerprint), NOT the PEM file hash.
for /f "usebackq delims=" %%H in (`powershell -NoProfile -Command "$c=New-Object System.Security.Cryptography.X509Certificates.X509Certificate2('%CRT%');[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($c.RawData)).Replace('-','')"`) do set "ACTUAL=%%H"
if /I not "!ACTUAL!"=="%FP_HEX%" (
  echo [ERROR] Fingerprint mismatch - aborting install.
  echo   expected: %FP_HEX%
  echo   actual:   !ACTUAL!
  del "%CRT%" >nul 2>&1
  pause
  exit /b 1
)

REM --- install into Trusted Root Certification Authorities ---
certutil -addstore -f Root "%CRT%"
if errorlevel 1 (
  echo [ERROR] Install failed.
  del "%CRT%" >nul 2>&1
  pause
  exit /b 1
)
del "%CRT%" >nul 2>&1

echo(
echo [OK] Installed to "Trusted Root Certification Authorities".
echo   Fully close your browser, reopen, and visit:
echo     https://__PUBLIC_HOST__
echo(
echo   Firefox uses its own store: Settings - Privacy - Certificates -
echo   View Certificates - Authorities - Import - rootCA.crt
echo(
pause
