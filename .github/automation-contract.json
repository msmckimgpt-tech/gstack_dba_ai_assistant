{
  "version": 1,
  "providers": {
    "default": "codex",
    "allowed": ["codex", "claude"],
    "labels": {
      "codex": "agent:codex",
      "claude": "agent:claude"
    }
  },
  "issues": {
    "types": ["feature", "bug", "task"],
    "sources": ["source:human", "source:autonomous"],
    "status_labels": {
      "ready": "status:ready",
      "blocking": ["status:blocked", "status:in-progress", "status:in-review"]
    }
  },
  "branches": {
    "public_pr_regex": "^issue/[0-9]+-[a-z0-9][a-z0-9-]*$",
    "public_pr_example": "issue/12-fix-browser-session-cleanup",
    "internal_parallel_pattern": "ai/<agent-id>/<issue-number>/<slice>",
    "internal_parallel_regex": "^ai/[a-z0-9][a-z0-9._-]*/[0-9]+/[a-z0-9][a-z0-9-]*$",
    "internal_parallel_example": "ai/codex/12/browser-cleanup"
  },
  "pull_requests": {
    "title_regex": "^#[0-9]+[[:space:]].+",
    "closing_reference_regex": "closes #[0-9]+"
  },
  "commits": {
    "types": ["feat", "fix", "docs", "refactor", "test", "chore"],
    "default_scope": "project",
    "subject_regex": "^(feat|fix|docs|refactor|test|chore)\\([a-z0-9][a-z0-9-]*\\): .+ \\(#[0-9]+\\)$",
    "issue_type_to_commit_type": {
      "feature": "feat",
      "bug": "fix",
      "task": "chore"
    }
  },
  "checks": {
    "required": [
      "policy-contract",
      "selfhosted-runtime-smoke",
      "ai-review",
      "owner-agent-report"
    ]
  },
  "classifiers": {
    "docs_only_patterns": [
      "^README\\.md$",
      "^CONTRIBUTING\\.md$",
      "^docs/.*$",
      "^unit/[^/]+/docs/.*$",
      "^\\.github/ISSUE_TEMPLATE/.*$",
      "^\\.github/pull_request_template\\.md$"
    ],
    "risk_manual_patterns": [
      "^\\.github/workflows/.*$",
      "^AGENTS\\.md$",
      "^CLAUDE\\.md$",
      "^docs/SECURITY\\.md$"
    ]
  }
}
