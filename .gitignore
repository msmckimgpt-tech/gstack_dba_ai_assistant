.env
# feature-0007 follow-up: secret 영역별 env 파일 분리 (least privilege).
# 운영자가 secret rotation 별 cycle 별도 진행 가능.
.env.bedrock
.env.mysql
.env.postgres
.env.minio
.env.llm
.env.secret
# TASK-20260619T034522-oauth-google-foundation: Google OAuth client 자격증명 (web 진입점 전용).
.env.oauth
# feature-0023: Conversation API MCP 서버용 Bearer 토큰·base URL (클라이언트 측 시크릿).
.env.conversation-mcp
.env.local
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
dist/
coverage/
.DS_Store
Thumbs.db
.vscode/
.idea/
_archive/
*:Zone.Identifier
.ai-runtime/
.env.local
**/config/credentials/*.cnf
**/config/credentials/*.env
!**/config/credentials/*.example
.gstack/

# codex session id / scratch context (per-worktree, gstack /codex 호출 시 생성).
.context/

# bin/template-upgrade.sh 산출물 — backup 트리와 실행 로그.
# `.template-state` 는 declared/applied 마이그레이션 상태라 git 추적 대상.
.template-backups/
.template-upgrade-logs/

# docker-compose dev override — 환경별 (developer machine 의 dev 가동 옵션).
# template 은 `docker-compose.override.yml.example` 로 추적. 실제 사용 파일은 gitignore.
docker-compose.override.yml

# worktree checkout paths (git worktree add 로 생성, repo 외부 경로)
.worktrees/
artifacts/

# Playwright MCP session logs (feature-0008)
.playwright-mcp/

# feature-0016: .env 안전 백업(비밀 포함) 커밋 방지
.env.bak*

# PB-0008 브라우저 하네스 런타임 서빙 디렉토리 (tests/pb0008_*.py 가 생성)
unit/*/tests/.pb0008-serve/
