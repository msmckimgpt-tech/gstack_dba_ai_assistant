{
  "name": "web-ui-smoke (예시 — 실제 selector 로 교체할 것)",
  "base_url": "http://localhost:18080",
  "shot_dir": "/tmp/win-browser-shots",
  "steps": [
    { "action": "goto", "url": "/" },
