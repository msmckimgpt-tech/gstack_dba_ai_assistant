# =============================================================================
# .env.mysql — MySQL 컨테이너 + DB 사용 service 의 자격증명
# =============================================================================
#
# **least privilege**: MYSQL_ROOT_PASSWORD / DB_PASSWORD 는 mysql + DB 호출
# service (web / agent / insight-worker / memory-init / mcp) 의 env_file 에만
# inherit. browser / caddy / bedrock-gateway / minio 는 본 파일 안 inherit.
#
# **운영자 책임**:
# - 본 파일은 `.gitignore` 됨. 실 password 는 사내 시크릿 관리자에서 발급.
# - rotation 시 mysql 컨테이너 + DB 호출 컨테이너 모두 재시작 필요.
# - REPLICA_DB_PASSWORD 도 read-only 복제 인스턴스 password — 별 환경에서
#   설정 가능 (TASK-0045 Approach A wedge).

MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REPLICA_DB_PASSWORD=

# TASK-0128 (#2): data-plane 전용 최소권한 RO 유저 (SELECT-only, agent_memory/mysql REVOKE).
# 미설정 시 DB_USER(root) 로 폴백. 운영자가 bin/agent-ro-bootstrap.sh 로 유저 생성 후 설정.
AGENT_DATA_DB_USER=agent_ro
AGENT_DATA_DB_PASSWORD=change_me_ro
