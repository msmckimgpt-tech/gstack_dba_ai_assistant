    {"action": "eval", "script": "(async()=>{var menu=document.getElementById('productDropupMenu');var items=[...menu.querySelectorAll('.product-dropup-item[data-mode=\"pinned\"]')];var report=items.slice(0,6).map(function(it){var kids=[...it.children].map(k=>(k.getAttribute('class')||k.tagName).split(' ')[0]);var ic=it.querySelector('.product-dropup-item-icon');return {pid:it.getAttribute('data-pid'),label:it.querySelector('.product-dropup-item-label').textContent,order:kids,icon:(ic?(ic.querySelector('img')?'img':(ic.querySelector('svg')?'identicon':'empty')):'none'),hasDs:!!it.querySelector('.product-dropup-item-ds')};});return JSON.stringify(report);})()", "stop_on_fail": false},

    {"action": "eval", "script": "(async()=>{var c=document.getElementById('productChip');try{c.click();}catch(e){}await new Promise(r=>setTimeout(r,300));return JSON.stringify({closedMenu:true});})()", "stop_on_fail": false},

