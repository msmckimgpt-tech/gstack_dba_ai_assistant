    {"action": "eval", "script": "(async()=>{var c=document.getElementById('productChip');c.click();await new Promise(r=>setTimeout(r,500));var menu=document.getElementById('productDropupMenu');var items=[...menu.querySelectorAll('.product-dropup-item[data-mode=\"pinned\"]')];var first=items[0];var kids=first?[...first.children].map(k=>(k.getAttribute('class')||k.tagName).split(' ')[0]):[];var iconEl=first?first.querySelector('.product-dropup-item-icon'):null;var hasSvg=iconEl?!!iconEl.querySelector('svg'):false;var hasImg=iconEl?!!iconEl.querySelector('img'):false;var label=first?first.querySelector('.product-dropup-item-label').textContent:null;var menuW=menu?getComputedStyle(menu).maxWidth:null;var menuRect=menu?menu.getBoundingClientRect().width:null;var labelEl=first?first.querySelector('.product-dropup-item-label'):null;var truncated=labelEl?(labelEl.scrollWidth>labelEl.clientWidth+1):null;return JSON.stringify({pinnedCount:items.length,firstChildOrder:kids,iconHasSvgOrImg:(hasSvg||hasImg),iconKind:(hasImg?'img':(hasSvg?'identicon':'none')),firstLabel:label,labelStartsWithParen:label?label.trim().startsWith('('):null,menuMaxWidth:menuW,menuRenderedWidth:menuRect,firstLabelTruncated:truncated});})()", "stop_on_fail": false},
