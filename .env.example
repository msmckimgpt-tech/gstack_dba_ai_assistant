# =============================================================================
# .env — 본 파일은 service-별 secret 분리 정책 (CHG-20260522-0005) 후 비-secret
# 영역만 보유. 실 secret 은 분리된 .env.* 파일에서 관리:
#   - .env.bedrock      AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (bedrock-gateway 전용)
#   - .env.mysql        MYSQL_ROOT_PASSWORD / DB_PASSWORD / REPLICA_DB_PASSWORD
#   - .env.postgres     AGENT_KB_PG_PASSWORD / AGENT_KB_PG_RW_PASSWORD / AGENT_KB_PG_RO_PASSWORD
#   - .env.minio        MINIO_ROOT_PASSWORD / MINIO_APP_ACCESS_KEY / MINIO_APP_SECRET_KEY
#   - .env.llm          LOCAL_LLM_API_KEY / BEDROCK_GATEWAY_API_KEY
# 각 .env.* 마다 .example committed (placeholder). 실 값은 사내 시크릿 관리자
# 에서 발급 후 .env.* 에 채운다. 모든 .env.* 는 `.gitignore` 됨.
#
# 마이그레이션 가이드 (기존 단일 .env 사용 운영자):
#   1. 본 cycle merge 후 첫 보일러플레이트: 본 .env.example 의 모든 변수가
#      그대로 .env 에 있어야 backward-compat. 단 secret 영역은 본 .env 에서
#      제거되고 각 .env.* 로 이동. 운영자가 기존 .env 의 password / API key /
#      secret 행을 해당 .env.* 로 옮기는 1 회 마이그레이션 필요.
#   2. docker-compose.yml 의 service 별 env_file list 가 자동으로 multi-file
#      inherit. 운영자 입장에서는 secret 분리만 신경.
# =============================================================================

MYSQL_IMAGE_TAG=
MYSQL_PORT=
TZ=
APP_LANG=
APP_LC_ALL=
APP_LANGUAGE=

# ── LLM provider model selection (non-secret) ─────────────────────────
# LLM_MODEL (TASK-0237 신규 이름): 비워두면 backend 의 `_resolve_session_default_model()`
# 가 `API_DEFAULT_MODEL` (`claude-sonnet-4`) fallback. 명시 값은 catalog 검증 후만
# 사용 (CHG-20260522-0002 의 catalog 검증 + Local LLM 가용성 cross-check).
# 권장 값: `LLM_MODEL=claude-sonnet-4` 또는 빈 값.
LLM_MODEL=
# OPENAI_MODEL (DEPRECATED): 구이름. LLM_MODEL 미설정 시에만 fallback 으로 읽힌다.
# 운영 .env 에 `OPENAI_MODEL=auto` 잔존 시 무중단 호환되나, LLM_MODEL 로 이전 권장.
# 다음 cycle 에 이 fallback 제거 검토.
OPENAI_MODEL=

# ── LLM gateway URL (non-secret — secret 은 .env.llm) ─────────────────
# Bedrock gateway URL + Local LLM gateway URL. 본 두 URL 자체는 secret 아님
# (internal service name 또는 LAN IP). 인증 token 만 .env.llm 분리.
LOCAL_LLM_API_BASE=

# ── feature-0007 Bedrock LLM provider gateway URL ─────────────────────
# **반드시 paired 로 설정** (.env.llm 의 `BEDROCK_GATEWAY_API_KEY` 와 함께):
# 본 URL + .env.llm 의 token 둘 다 채워야 backend 가 Bedrock 로 라우팅. 한 쪽만
# 채우면 fallback chain 이 다음 provider 로 넘어감 (CHG-20260522-0003 의 paired
# tuple 정책).
#
# LLM provider 우선순위 (paired only — CHG-20260522-0006: OpenAI direct 제거):
#   1. Bedrock gateway: BEDROCK_GATEWAY_URL + .env.llm 의 BEDROCK_GATEWAY_API_KEY 둘 다.
#   2. Local LLM gateway: LOCAL_LLM_API_BASE + .env.llm 의 LOCAL_LLM_API_KEY 둘 다.
BEDROCK_GATEWAY_URL=http://bedrock-gateway:8080/v1
AWS_REGION=ap-northeast-2
AGENT_OBJECT_RESOLVE_MODEL=
AGENT_SQL_COMPOSE_MODEL=
AGENT_SQL_REVIEW_MODEL=
AGENT_INSIGHT_MODEL=
AGENT_PLAN_MODEL=
AGENT_TASK_CLASSIFY_MODEL=
AGENT_SQL_FIX_MODEL=
AGENT_ANSWER_MODEL=
AGENT_STEP_GRADE_MODEL=
AGENT_SUMMARY_MODEL=
AGENT_TOPIC_MODEL=
AGENT_DISABLE_REMOTE_FALLBACK=
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
REPLICA_DB_HOST=
REPLICA_DB_PORT=
REPLICA_DB_USER=
REPLICA_DB_NAME=
REPLICA_NETWORK_NAME=

# ── 멀티 datasource (P1, DESIGN-multi-datasource.md Stage 1) ───────────────────
# 여러 MySQL datasource 를 등록하고 product 별로 분석 대상을 고를 수 있게 한다.
# flag OFF(기본/미설정) 면 기존 단일 MySQL(DB_HOST) 동작 그대로 — 0 변경.
# 보안: datasource 접근 RBAC 와 스키마 allowlist 는 기존 product 권한(product.access.<key>)
#       + WebProductDatabases 가 그대로 담당. product 에 DatasourceKey 를 바인딩하면
#       그 product 권한이 곧 datasource 접근 게이트(연결 전 enforce).
#       각 DS_<KEY>_USER 는 product 허용 DB(WebProductDatabases)에만 GRANT SELECT 한 최소권한 RO 유저여야 함.
AGENT_MULTI_DATASOURCE_ENABLED=
# ── 데이터소스 관리 (TASK-0211 부터: DB 일원화) ──
# 데이터소스는 **DB 레지스트리(WebDatasources, 암호화)에서 관리 콘솔로 CRUD** 한다.
# 아래 .env 방식(AGENT_DATASOURCE_KEYS + DS_<KEY>_*)은 **deprecated** — 설정하면 부팅 시
# _migrate_env_datasources_to_db 가 DB 로 1회 이전(암호화)하므로, 신규 등록은 관리 콘솔을 사용하라.
# .env 는 앱 인프라('Database Query Assistant' = 데이터 MySQL AGENT_DATA_DB_*(.env.mysql) /
# agent_memory / 마스터키 AGENT_DATASOURCE_KEK_V<n>(.env.secret))만 둔다.
AGENT_DATASOURCE_KEYS=
# (legacy/deprecated) DS_PROD_HOST= / DS_PROD_PORT=3306 / DS_PROD_USER=ro_prod / DS_PROD_DEFAULT_DB=appdb
AGENT_BLOCKED_DEFAULT_SCHEMAS=
AGENT_MEMORY_DB=
AGENT_LOG_DIR=
AGENT_OUT_DIR=
AGENT_TOP_N=
AGENT_MAX_SHOW=
AGENT_TIMEOUT_SEC=
# ── 데이터플레인 연결 격리 (ds-connect-isolation) ──────────────────────────────
# 원격 customer datasource 연결 수립 상한(초). 쿼리 예산 AGENT_TIMEOUT_SEC 와 분리 —
# 불안정 datasource 가 단일 ask-worker 를 점유해 정상 datasource 제품까지 지연되는 것을
# 차단. 기본 10. 0/미설정 시 AGENT_TIMEOUT_SEC 폴백(기존 동작). control-plane(memory DB)
# 연결은 미적용.
AGENT_DB_CONNECT_TIMEOUT_SEC=
# per-datasource circuit breaker. 한 datasource 가 연속 실패하면 그 datasource 만 일정 시간
# 즉시 fail-fast → datasource 별 격리. ENABLED 기본 1(활성). FAIL_THRESHOLD 기본 3,
# COOLDOWN_SEC 기본 30. 연결성 에러만 카운트(인증 오류 등 fast-fail 은 제외).
AGENT_DB_BREAKER_ENABLED=
AGENT_DB_BREAKER_FAIL_THRESHOLD=
AGENT_DB_BREAKER_COOLDOWN_SEC=
# TASK-0237: 새 이름. 구이름 AGENT_OPENAI_MAX_RETRIES 미설정 시에만 fallback.
AGENT_LLM_MAX_RETRIES=
# AGENT_OPENAI_MAX_RETRIES (DEPRECATED): AGENT_LLM_MAX_RETRIES 로 이전 권장.
AGENT_OPENAI_MAX_RETRIES=
AGENT_PLAN_TIMEOUT_SEC=
AGENT_PLAN_TIMEOUT_RECOVERY_SEC=
AGENT_PLAN_TIMEOUT_MIN_SEC=
