# TASK-0205: datasource 자격증명 envelope 암호화 마스터 KEK (루트 키).
# 이 파일(.env.secret)은 .env 와 분리한다 — .env 는 전 service 가 inherit 하므로 least-privilege 상
# 마스터키를 두기 부적합(SECURITY.md §6.1). agent-common(web/ask-worker/insight-worker)만 로드.
#
# 생성: python3 -c "import base64,os;print('AGENT_DATASOURCE_KEK_V1='+base64.b64encode(os.urandom(32)).decode())"
# 32바이트 base64. 버전별 키(_V1,_V2…)로 로테이션 — 구 버전 키는 보관해야 구 레코드 복호 가능.
# **이 키 유출 = 전 datasource 비밀번호 노출.** 파일 권한 600 + docker secret 권고. DB 에 저장 금지.
AGENT_DATASOURCE_KEK_V1=
# (옵션) SSRF host allowlist — 사설망 정당 대상 CIDR/host (예: Windows MSSQL). 콤마구분.
# AGENT_DATASOURCE_HOST_ALLOWLIST=172.28.64.1
#
# (옵션) TASK-0228: datasource 사설/링크로컬 IP 차단(SSRF 경계) 토글. 기본 활성(secure-by-default).
# 사내 환경이 대부분 사설망 IP(RFC1918, 예: 10.200.50.80)로 DB 를 운영하면 매 host 를 allowlist 에
# 등록하는 대신 본 경계 자체를 0 으로 비활성화할 수 있다. 비활성화해도 클라우드 메타데이터 IP
# 하드차단(169.254.169.254 등)과 DNS rebinding pin 은 유지된다. 복원: 값을 1 로 되돌리면 즉시 재활성.
# **사설망 SSRF 방어를 끄는 보안 trade-off** — 신뢰 가능한 사내 네트워크에서만 사용.
# AGENT_DATASOURCE_SSRF_GUARD_ENABLED=0
