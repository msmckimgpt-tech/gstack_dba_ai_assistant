# codex session id / scratch context (per-worktree, gstack /codex 호출 시 생성).
.context/

# bin/template-upgrade.sh 산출물 — backup 트리와 실행 로그.
# `.template-state` 는 declared/applied 마이그레이션 상태라 git 추적 대상.
.template-backups/
.template-upgrade-logs/

# docker-compose dev override — 환경별 (developer machine 의 dev 가동 옵션).
# template 은 `docker-compose.override.yml.example` 로 추적. 실제 사용 파일은 gitignore.
docker-compose.override.yml

# worktree checkout paths (git worktree add 로 생성, repo 외부 경로)
.worktrees/
artifacts/

# Playwright MCP session logs (feature-0008)
.playwright-mcp/

# feature-0016: .env 안전 백업(비밀 포함) 커밋 방지
.env.bak*

# PB-0008 브라우저 하네스 런타임 서빙 디렉토리 (tests/pb0008_*.py 가 생성)
unit/*/tests/.pb0008-serve/

# CI/로컬 pytest 가 컨테이너와 동형 경로를 만들려고 생성하는 심링크 — 커밋 대상 아님
/web

# gstack browse/terminal 데몬 런타임 부산물 — 인증 토큰·PID·포트 (v3.48.0 hop 추가.
# §16.6 의 /browse 요구가 이 파일들을 만든다 — 실측 2026-08-14: 완료 게이트 PASS
# 직후 실토큰 2건이 커밋·push 됐다)
.gstack/browse*.log
.gstack/browse*.jsonl
.gstack/browse.json
.gstack/terminal-*
.gstack/claude-available.json

# ── 브리지 러너 배포 산출물 — 소스는 `unit/feature-0043-external-llm-bridge/src/agent/`
# (AGENTS.md §13.1 v3.35.1 «1순위: 생성물을 소스에 커밋하지 말고 빌드가 만든다»)
#
# 종전 배치는 정본과 배포본이 **바이트 동일한 두 커밋 대상**이었고, 최근 90일 49개 커밋이
# 예외 없이 둘 다 고쳤다(49/49). 관심사가 다른 두 세션도 264KB 짜리 같은 파일에서 반드시
# 만나 충돌했다. 이제 셋 다 빌드 생성물이다:
#   - 이미지: Dockerfile 의 `scripts/build_bridge_agent.py` 실행
#   - 테스트: 루트 `conftest.py` 가 collection 전에 배치
#   - 로컬  : `make bridge-agent`
unit/feature-0043-external-llm-bridge/src/bridge_agent.py
unit/feature-0003-agent-web-ui/src/static/agent/bridge_agent.py
unit/feature-0003-agent-web-ui/src/static/agent/bridge_setup.sh
unit/feature-0003-agent-web-ui/src/static/agent/bridge_setup.ps1
unit/*/docs/reviews/.state-*
unit/*/meta/reviews/.state-*
unit/*/docs/.review-lock
unit/*/meta/.review-lock
meta/.review-lock
meta/reviews/.state-*
