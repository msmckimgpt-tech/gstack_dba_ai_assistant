{
	auto_https off
}

http://{$WEB_PUBLIC_HOST}, :80 {
	# TASK-20260617T083954-ai-claude-trust-bundle (AC-0557): Root CA 신뢰 설치 번들은 평문 HTTP 로 제공한다 — 테스터가 아직
	# CA 를 설치하지 않은 상태(HTTPS 경고)에서도 경고 없이 받게 하기 위함. 그 외 경로는 HTTPS 로.
	handle /trust {
		redir {http.request.scheme}://{host}/trust/ permanent
	}
	handle_path /trust/* {
		root * /srv/trust
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

https://{$WEB_PUBLIC_HOST}, :443 {
	tls {$WEB_TLS_CERT_FILE} {$WEB_TLS_KEY_FILE}

	# api-exposure-hardening (2026-08-11): 브라우저 보안 헤더. 외부 AI(codex) 의 무인증 API 감사가
	# "로그인 입력을 받는 페이지에 주요 보안 헤더가 하나도 없다" 를 적발했고 라이브 실측으로 재현했다
	# (루트 200 응답에 nosniff·frame-ancestors·Referrer-Policy 전무). 엣지에서 전 응답에 일괄 부착한다 —
	# 앱 층 개별 부착(첨부·미디어 응답의 nosniff)은 HTML 문서 응답을 덮지 못했다.
	#
	# HSTS 는 의도적으로 제외한다. 위 http:// 블록의 `/trust/*` 는 사내 Root CA 미설치 상태의 테스터가
	# TLS 경고 없이 번들을 받도록 **평문 HTTP 로 서빙하는 설계**(TASK-20260617T083954)인데, HSTS 는
	# 호스트 단위로 걸려 경로 예외를 둘 수 없다 — 한 번이라도 HTTPS 응답을 받은 브라우저는 이후
	# `http://<host>/trust/` 를 HTTPS 로 강제 업그레이드해 CA 신뢰 부트스트랩 경로가 막힌다. 게다가
	# HSTS 는 브라우저에 캐시되어 롤백이 즉시 반영되지 않는다. CA 배포 채널을 HTTP 외로 옮긴 뒤
	# 별 cycle 에서 함께 결정한다.
	header {
		# MIME 스니핑 차단 — 업로드/첨부 응답에만 있던 것을 전 응답으로 확장.
		X-Content-Type-Options nosniff
		# 클릭재킹 차단. 정적 화면 3종(index/admin/share) 모두 iframe 미사용(실측 0건)이라 안전.
		X-Frame-Options DENY
		# Referer 누출 축소 — 외부로는 origin 만, 다운그레이드 시 미전송.
		Referrer-Policy strict-origin-when-cross-origin
		# 미사용 강력 기능 비활성(기능 회귀 없음 — 카메라/마이크/위치 사용처 0).
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		# 서버 구현 노출 축소(uvicorn 버전 정찰 표면).
		-Server
	}

	# CSP 는 Report-Only 로 먼저 배포한다 — enforce 로 바로 켜면 PixiJS 그래프·mermaid 렌더가
	# blob/worker 를 쓰는 경로에서 조용히 깨질 수 있다(헤드리스로 관측 안 되는 부류). 화면 3종은
	# inline <script> 0건·on*= 핸들러 0건이라 script-src 는 'self' 로 충분하나, style= 속성이
	# 있어(admin 43건) style-src 는 'unsafe-inline' 이 필요하다. 외부 origin 은 Bunny Fonts 뿐.
	# 위반 리포트를 관측한 뒤 다음 cycle 에서 enforce 로 승격한다.
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src 'self' data: https://fonts.bunny.net; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	# feature-0026 (M6): edge access log — 계측 사각 B2(엣지 QPS/상태코드/업스트림 지연 무기록) 해소.
	# stdout(JSON) → docker json-file 로그(20m×5 rotate, compose 전역 상한)로 수집 — 별도 볼륨/파일 없음.
	# 요청 지연은 duration 필드로 사후 분석(bin/perf-snapshot.sh 소비).
	# §18.8 sec B4: uri 의 share 토큰(/share/<tok> 류 = 무인증 bearer-capability, SECURITY §9.2
	# prefix-only 원칙)과 쿼리스트링을 마스킹해 로그면에 전문이 축적되지 않게 한다. 쿠키·Authorization
	# 은 Caddy 기본 REDACTED(실측 확인). 필터 문법은 배포 시 reconcile_caddy 의 adapt 검증이 게이트.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp (/share/|/api/public/share/|/api/share/)[^/?]+|\?.* [REDACTED]
			}
		}
	}

	# TASK-20260617T083954-ai-claude-trust-bundle: 설치 후/직접 접근용으로 HTTPS 에서도 동일 번들을 서빙한다.
	handle /trust {
		redir {http.request.scheme}://{host}/trust/ permanent
	}
	handle_path /trust/* {
		root * /srv/trust
		file_server
	}

	# TASK-0297 (AC-0554): web 은 ENABLE_WEB_TLS=1 로 8000 에서 HTTPS 를 서빙하므로
	# upstream 으로 평문 HTTP 가 아닌 HTTPS 로 연결한다 (평문 연결 시 502). 사내 Root CA
	# 로 web leaf 인증서를 검증하고(tls_trust_pool), SNI/검증 이름은 leaf SAN 과
	# 일치하는 공개 호스트명을 사용한다(tls_server_name — 내부 서비스명은 SAN 부재).
	#
	# feature-0014 (Tier 2 무중단): 단일 upstream(web:8000) → 2-replica LB(web-a/web-b).
	# deploy-web.sh 가 한 번에 하나씩 재시작 → 항상 ≥1 healthy upstream.
	#  - zero-502 의 핵심 lever = dial 실패 retry(passive): 죽어가는 replica 로 dial 한 요청을
	#    lb_try_duration 동안 healthy replica 로 재시도. active health 의 검출 lag(~2-4s)을 메운다.
	#  - lb_policy cookie(sticky): 한 클라이언트의 HTML + /static/* 자산이 같은 replica 에서
	#    오게 해 롤아웃 중 버전 스큐(HTML=NEW / asset=OLD)와 캐시 오염을 제거. sticky replica
	#    가 down 되면 cookie 재배정 + retry 로 healthy replica 로 자동 전환(무중단 유지).
	#  - active health 는 /livez(DB 무관 liveness)로 — /healthz(DB ping)로 하면 DB 가 잠깐
	#    느릴 때(예: migrate 중) 양 replica 가 동시에 unhealthy 로 빠져 502 가 날 수 있다.
	#  - 두 replica 는 동일 leaf(SAN=WEB_PUBLIC_HOST)를 공유하므로 per-transport SNI 하나로 충분.
	# feature-0027 (P0-E): 텍스트 자산 압축 — 작업/관리 화면 초기 로드 1.1MB+ 비압축(app.js
	# 639KB·admin.js 700KB·styles.css 309KB, 전수 조사 S2-3)을 zstd/gzip 로 ~1/5 로 축소.
	# §18.8 backend C4: 압축 대상을 명시 allowlist 로 — `text/event-stream`(SSE 토큰 스트리밍,
	# X-Accel-Buffering:no 자기선언)이 기본 `text/*` 매칭에 걸려 flush 경계/버전에 따라
	# 토큰 단위 실시간성이 열화되는 것을 원천 제외한다.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type image/svg+xml*
		}
	}

	# feature-0027 (P0-E) 가 두었던 `header @static_versioned Cache-Control immutable` 은
	# feature-0014 asset-stamp-cache-integrity (2026-07-28) 에서 **제거**하고 upstream(web) 이
	# 결정하도록 넘겼다. 정책 의도(“`?v=` stamp 를 실은 요청만 immutable, unstamped 는 ETag/304”)는
	# 그대로 유지되며 web 의 `static_cache.StaticCacheHeadersMiddleware` 가 이어받는다.
	#
	# 왜 엣지에서 못 하는가 — 엣지는 `?v=` 의 **존재**만 볼 수 있고 그 값이 *응답한 replica 의
	# 빌드*인지 알 수 없다. 정적 파일은 각 replica 로컬 FS 에서 경로만으로 서빙되므로(쿼리 무시),
	# 롤링 배포 창에 구 replica 가 `?v=<신 스탬프>` 요청에 구 바이트로 200 응답할 수 있고 그것이
	# immutable 로 1년 고착된다(라이브 실측 2026-07-28: 배포 후에도 구 JS 렌더). upstream 만이
	# 자기 빌드 스탬프(`static/.asset-stamp`)를 알아 “일치할 때만 immutable / 불일치면 no-store”
	# 를 판정할 수 있다. 여기서 헤더를 강제하면 그 판정을 덮어써 불변식이 무력화되므로 두지 않는다.

	# ── 외부 AI 도구 표면 MCP (HTTP/SSE, feature-0041) ────────────────────────────
	# 외부 AI 가 런처 설치 없이 URL 하나로 붙게 하는 경로 — 같은 호스트·같은 인증서를 쓰므로
	# 사용자는 `https://<host>/api/ai/mcp` 와 access token 만 등록하면 된다.
	#
	# ⚠ `handle` 순서가 의미를 갖는다 — 이 블록이 아래 기본 `handle`(web) 보다 **앞**에 있어야
	#   web 으로 새지 않는다. 경로 접두는 `/api/ai/mcp` 이고 `/api/ai/*` 의 다른 경로
	#   (manifest·guide·openapi·capabilities·tools·oauth)는 그대로 web 이 받는다.
	#
	# MCP streamable-http 는 장수명 스트림을 쓰므로 flush 를 끄고 타임아웃을 넉넉히 둔다.
	# upstream 이 죽어도 이 경로만 502 이고 대화 서빙(web)은 무영향이다.
	# codex P2: MCP 전송 계층에는 인증 verifier 가 없고 Bearer 는 **도구 실행 시점**에만 검사된다.
	# 그 사이에 무인증 클라이언트가 initialize/세션/스트림을 열어 프로세스 메모리를 소모할 수
	# 있으므로, 엣지에서 **Authorization 헤더 존재 자체**를 요구해 익명 연결을 아예 차단한다.
	# (유효성 검사는 여전히 upstream 의 몫 — 여기서 하는 것은 익명 차단뿐이다.)
	handle /api/ai/mcp* {
		# ⚠ 이 검사는 **handle 블록 안**에 있어야 한다. 밖에 두면 adapt 결과에서 이 라우트가
		#   `handle` 뒤로 밀려 익명 요청이 먼저 프록시로 나간다(무력화). 블록 안에서는
		#   `respond` 가 `reverse_proxy` 보다 앞서 평가된다.
		@noauth not header Authorization *
		respond @noauth 401 {
			body "{\"error\":\"unauthorized\",\"error_description\":\"Authorization: Bearer <access_token> required\"}"
			close
		}

		reverse_proxy ext-tool-mcp:8971 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		reverse_proxy web-a:8000 web-b:8000 {
			lb_policy cookie weblb
			# zero-502 의 retry 는 lb_try_duration 이 구동한다(시간 한도 내 재선택). dial 실패
			# (recreate 로 죽은 replica 로의 연결 거부)는 항상 재시도되어 healthy replica 로 넘어간다.
			# 주의: 짧은 non-GET(예: POST) 이 연결 성립 후 replica 가 mid-request 로 죽는 극히 짧은
			# 창은 기본 lb_retry_match(GET 한정)상 재시도되지 않는다 — 단 SIGTERM 시 uvicorn 이
			# in-flight 를 stop_grace_period(30s) 동안 drain 하므로 그 창은 sub-second 수준.
			lb_try_duration 5s
			lb_try_interval 250ms

			# ⚠ passive health 는 **롤링 배포와 결합된 값**이다 (2026-08-11 라이브 사고).
			#
			# fail_duration = 실패한 upstream 이 LB 후보에서 빠져 있는 시간. 이 값이 롤링의
			# replica 간 간격보다 길면 무중단 불변식이 깨진다:
			#   web-a recreate → Fails(web-a)=1 → web-a 는 fail_duration 동안 후보 제외
			#   → 스파인이 web-a 의 앱 /readyz 만 보고 ~10s 뒤 web-b 를 내림
			#   → **두 replica 모두 후보 제외 = `no upstreams available`** → lb_try_duration 소진 후 503.
			# 실측: 배포 1회당 12~17초 전면 503(엣지 에러 `no upstreams available` 71건/6h).
			# 그 창에서 active health 는 양 replica 모두 `host is up` 이었다 — passive 배제가 유일
			# 원인이었고, 503 종료 시각이 매번 "먼저 내린 replica 의 첫 실패 + 30s" 와 일치했다.
			#
			# **해법은 이 값을 낮추는 것이 아니다.** 값을 낮추면(예: 3s) 롤링 창은 좁아지지만
			# 실장애 격리가 함께 약해진다 — `/livez` 는 통과하면서 특정 요청만 5xx 를 내는
			# upstream(= active health 가 못 잡는 유형)이 3초마다 다시 투입된다. 그 트레이드오프를
			# 정당화할 SLO 근거가 없어 채택하지 않았다(적대 검증 P2 지적).
			# 대신 **결합을 스파인이 흡수한다**: `bin/deploy-web.sh` 의 `wait_edge_available` 이
			# 다음 replica 를 내리기 전에 Caddy admin API 로 직전 replica 의 `fails==0` 복귀를
			# 확인하고, 확인되지 않으면 배포를 **중단**한다(기존 replica 는 계속 서빙 = 무중단 유지).
			# 그래서 이 값은 "장애 격리 강도" 라는 본래 역할로 판단하면 된다.
			#
			# 값을 바꿀 때: 스파인의 `EDGE_AVAIL_TIMEOUT`(기본 60s)보다 작아야 게이트가 timeout
			# 으로 무력화되지 않는다. 그 관계는 test_edge_rolling_gate.py G6 가 잠근다.
			fail_duration 30s
			max_fails 1

			health_uri /livez
			health_interval 2s
			health_timeout 2s
			health_passes 1
			health_fails 1
			# active health 프로브는 dial host(web-a:8000)를 Host 로 보내므로, 앱의 host 검증
			# (WEB_ALLOWED_HOSTS → TrustedHost)이 400 으로 거부해 양 replica 가 동시 down 된다.
			# 실 트래픽은 클라 Host 를 전달해 무관. 프로브 Host 를 공개 호스트로 고정. (feature-0014 라이브 적발)
			health_headers {
				Host {$WEB_PUBLIC_HOST}
			}

			transport http {
				tls
				tls_trust_pool file /certs/rootCA.pem
				tls_server_name {$WEB_PUBLIC_HOST}
				dial_timeout 5s
			}
			# 클라이언트 Host 를 upstream 으로 보존. 다중 upstream(web-a/web-b) 환경에서 Host 가
			# 내부 서비스명(web-a)으로 나가면 앱 TrustedHost(WEB_ALLOWED_HOSTS)가 400 거부한다.
			# (구 단일 upstream 은 allowlist 에 'web' 가 있어 우연히 통과했음.) feature-0014 라이브 적발.
			header_up Host {host}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}
}
