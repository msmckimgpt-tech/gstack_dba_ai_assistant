# docker-compose.override.yml — DEV / EXTERNAL-EXPOSED 가동 옵션 template
#
# 사용:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up -d web
#
# docker compose 가 자동으로 docker-compose.yml + docker-compose.override.yml 을
# merge 한다. 추가 옵션 없이 `make web` 또는 `docker compose up -d web` 으로
# override 가 적용된다. production / staging 배포 시 이 파일을 두지 않거나
# `-f docker-compose.yml` 만 명시하면 override 무시.
#
# 두 가지 사용 시나리오:
#
# (A) Local dev — gstack browse / curl / playwright 의 self-signed cert
#     번거로움 회피용. 평문 HTTP 8000 으로 작동. 외부 노출 금지.
#     → 아래 `services.web.entrypoint` 의 "Variant A" 를 사용.
#
# (B) 외부-노출 single-instance (TASK-0104) — 외부 IP 직접 접근 + WebCrypto
#     SubtleCrypto secure-context 요건 충족. web 컨테이너 자체가 TLS 종단.
#     `.env` 에 `ENABLE_WEB_TLS=1`, `WEB_TLS_CERT_FILE` / `WEB_TLS_KEY_FILE`
#     설정 + `../artifacts/certs/<host>/{fullchain,privkey}.pem` 배치 필요.
#     → 아래 `services.web.entrypoint` 의 "Variant B" 를 사용.
#
# (C) Production (Caddy 동반): Caddy (`80/443`) 가 TLS 종단 → web 내부 HTTP.
#     이 경우 본 override 자체를 두지 않거나 `-f docker-compose.yml` 만 사용.

services:
  web:
    # docker-compose.yml 의 entrypoint 는 `if [ "$ENABLE_WEB_TLS" = '1' ]; ...`
    # 분기를 가지지만, `$ENABLE_WEB_TLS` 가 compose 변수 보간 단계에서 `.env`
    # 값으로 이미 치환되어 단순 environment override 로는 분기 제어가 어렵다.
    # 따라서 entrypoint 자체를 명시적으로 plain HTTP / HTTPS 둘 중 하나로 지정.

    # Variant A — local dev (plain HTTP):
    # entrypoint: ["/bin/sh", "-c", "exec uvicorn web.app:app --host 0.0.0.0 --port 8000"]

    # Variant B — 외부-노출 single-instance (HTTPS, TASK-0104 default):
    entrypoint: ["/bin/sh", "-c", "exec uvicorn web.app:app --host 0.0.0.0 --port 8000 --ssl-keyfile /certs/mysql-ai.company.local/privkey.pem --ssl-certfile /certs/mysql-ai.company.local/fullchain.pem"]
