# feature-0023 (REQ-20260722-conversation-api-access) — Conversation API MCP 서버 설정 예시.
#
# 실제 값은 .env.conversation-mcp (gitignored) 에 채운다. 이 example 만 커밋한다.
# 토큰은 시크릿이다 — 커밋/로그/공유 금지.
#
# 활성화:
#   1) bin/api-token-issue.sh --account <저권한 서비스계정> --label "<용도>" 로 토큰 발급
#      (원문은 발급 시 1회만 표시 — 아래 CONVERSATION_API_TOKEN 에 붙여넣는다).
#   2) 이 파일을 .env.conversation-mcp 로 복사 후 값 채우기.
#   3) MCP 클라이언트(.mcp.json 의 conversation-api)가 자동 기동.

# 활성 스위치 — 1 이어야 서버가 뜬다(미설정/0 이면 no-op).
CONVERSATION_MCP_ENABLED=1

# 웹 서비스 베이스 URL (사내). https 사내 도메인 또는 로컬 포트.
CONVERSATION_API_BASE_URL=https://mysql-ai.company.local
# CONVERSATION_API_BASE_URL=http://localhost:8000

# Bearer API 토큰 원문(matk_...). bin/api-token-issue.sh 발급분.
CONVERSATION_API_TOKEN=matk_REPLACE_WITH_ISSUED_TOKEN

# 사내 self-signed TLS 면 0 으로 검증 비활성(그 외 기본 검증).
# CONVERSATION_API_VERIFY_TLS=0

# ask 기본 모델(생략 시 서비스 기본 API_DEFAULT_MODEL).
# CONVERSATION_API_DEFAULT_MODEL=

# HTTP 타임아웃(초, 기본 120).
# CONVERSATION_API_TIMEOUT_SEC=120
