# TASK-20260619T034522-oauth-google-foundation (REQ-20260619-0328): Google OAuth 로그인 토대.
# 사내 웹서비스 편입 기반작업. 이 파일(.env.oauth)은 gitignore — 실제 값은 커밋 금지.
# 운영자가 Google Cloud Console 에서 OAuth 2.0 Client(웹 애플리케이션) 를 발급한 뒤 채운다.
# 정책 정본 = docs/SECURITY.md §15 + feature-0003 FUNCTION.md AC-0600~0601.
#
# === 활성화 절차 (credential 주입 시) ===
# 1) Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID 생성
#    - 애플리케이션 유형: 웹 애플리케이션
#    - 승인된 리디렉션 URI: 아래 WEB_OAUTH_GOOGLE_REDIRECT_URI 와 정확히 일치해야 함
#      (예: https://<사내도메인>/api/auth/oauth/google/callback)
# 2) 발급된 Client ID / Client Secret 을 아래에 채운다.
# 3) WEB_OAUTH_GOOGLE_ENABLED=1 로 설정한다.
# 4) sudo docker compose up -d --no-deps web 으로 web 컨테이너만 재기동한다.
# 권한이 모두 채워지지 않으면(_oauth_google_configured()=False) 엔드포인트는 404 로 비활성 유지.

# 활성 토글 — 1/true/yes/on 이면 활성(기본 비활성).
WEB_OAUTH_GOOGLE_ENABLED=0

# Google Cloud Console 에서 발급한 OAuth 2.0 Client ID / Secret.
WEB_OAUTH_GOOGLE_CLIENT_ID=
WEB_OAUTH_GOOGLE_CLIENT_SECRET=

# 콜백 URI — Google Console 의 "승인된 리디렉션 URI" 와 바이트 단위로 일치해야 한다.
# 예) https://dqa.example.com/api/auth/oauth/google/callback
WEB_OAUTH_GOOGLE_REDIRECT_URI=

# (옵션) 허용 도메인 화이트리스트 — 콤마 구분. 비우면 모든 Google 계정 허용
# (사용자 결정 2026-06-19). 사내 Workspace 한정이 필요하면 도메인을 채운다(예: example.com).
# 외부 노출 시 도메인 한정 권장(SECURITY.md §15.4).
WEB_OAUTH_GOOGLE_ALLOWED_DOMAINS=

# (옵션) state/PKCE HMAC 서명 비밀. 미설정 시 프로세스 기동마다 임의값(재시작 시 in-flight
# OAuth 무효). 멀티워커/영속이 필요하면 32바이트 이상 임의 hex 로 고정한다.
# 생성: python3 -c "import secrets;print('WEB_OAUTH_STATE_SECRET='+secrets.token_hex(32))"
WEB_OAUTH_STATE_SECRET=

# (옵션) state 유효 시간(초). 기본 600(10분).
WEB_OAUTH_STATE_TTL_SEC=600

# ===========================================================================
# Google Drive 연동 토대 (feature-0010, TASK-20260623T190000-gdrive-foundation)
# ---------------------------------------------------------------------------
# 각 계정이 본인 Google Drive 를 연결하는 멀티테넌트 연동의 인증 설정. 이 파일(.env.oauth)은
# gitignore — 실제 값 커밋 금지. 정책 정본 = docs/SECURITY.md §16 + feature-0010 FUNCTION.md.
# 본 cycle 은 "연동 미수행" 토대 — 기본 비활성. 채우지 않으면 _gdrive_configured()=False 로
# /api/integrations/google-drive/{connect,callback} 은 404(런타임 무영향).
#
# === 활성화 절차 (배포 전 SECURITY.md §16 강화 TODO 충족 후) ===
# 1) Google Cloud Console > API/서비스 > Google Drive API 활성 + OAuth 동의화면에 Drive scope 추가.
# 2) 로그인용과 동일 OAuth 2.0 Client 를 재사용하거나(아래 비우면 WEB_OAUTH_GOOGLE_* 공유),
#    Drive 전용 Client 를 별도 발급해 아래에 채운다.
# 3) 승인된 리디렉션 URI 에 WEB_GDRIVE_REDIRECT_URI 와 바이트 단위로 일치하는 값 등록
#    (예: https://<사내도메인>/api/integrations/google-drive/callback).
# 4) WEB_GDRIVE_ENABLED=1 설정 후 web 컨테이너 재기동.

# 활성 토글 — 1/true/yes/on 이면 활성(기본 비활성).
WEB_GDRIVE_ENABLED=0

# Drive 전용 OAuth Client. 비우면 로그인용(WEB_OAUTH_GOOGLE_CLIENT_ID/SECRET) 을 공유한다.
WEB_GDRIVE_CLIENT_ID=
WEB_GDRIVE_CLIENT_SECRET=

# Drive 연동 콜백 URI — Google Console 의 "승인된 리디렉션 URI" 와 바이트 단위로 일치해야 한다.
# 로그인 콜백(/api/auth/oauth/google/callback) 과 다른 별도 경로다.
# 예) https://dqa.example.com/api/integrations/google-drive/callback
WEB_GDRIVE_REDIRECT_URI=

# (옵션) 요청 scope. 기본 drive.readonly(읽기 전용 — 최소권한). 쓰기가 필요하면 명시 승격
# (예: https://www.googleapis.com/auth/drive.file). 승격 시 사람 재승인 권장(SECURITY.md §16).
WEB_GDRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly
