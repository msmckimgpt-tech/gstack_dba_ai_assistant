# ── 사업팀 pilot 계정 발급 placeholder (TASK-0044) ──
# 실제 계정은 admin console 에서 수동 발급한다. 아래는 문서 내 치환용 이름이며
# 코드가 이 값을 참조해 auto-create 하지는 않는다.
# 예: WEB_PILOT_SALES_USERNAMES=sales_lee,sales_kim,sales_park
WEB_PILOT_SALES_USERNAMES=

# ── TASK-0015 §2.1.4 (KB Postgres pgvector 마이그레이션) ──
# M0 cycle: postgres (pgvector/pgvector:pg16) standalone 서비스 + _pg_connect() helper.
# M1+ 에서 role 분리 + DDL + dual-write + cutover 진행. 본 변수들의 실 사용은 phase 별로 점진.
#
# Postgres KB connection (M0~M5 전반):
AGENT_KB_PG_HOST=
AGENT_KB_PG_PORT=
AGENT_KB_PG_DB=
AGENT_KB_PG_USER=
AGENT_KB_PG_SSLMODE=
# Runtime DDL credential (M2 bootstrap fix — REV-20260526-0001 B-1 흡수).
# `_ensure_pg_schema()` 가 schema 누락을 감지하면 본 credential 로 별도 superuser
# connection 을 열어 DDL (CREATE TABLE / EXTENSION) 을 직접 적용. agent_kb_rw 는
# DML 전용 role 이라 DDL 권한 없음 → SUPER* 필요. 운영 환경 권장: bootstrap
# (`bin/kb-pg-role-bootstrap.sh --apply-schema`) 가 사전 적용 후 SUPER* unset 유지
# → memory-init 은 검증만 수행. unset + schema 부재 + AGENT_KB_PG_REQUIRED=1 조합은
# fail-loud (RuntimeError + actionable hint).
# legacy fallback: SUPER* unset 일 때 `AGENT_KB_PG_USER` / `AGENT_KB_PG_PASSWORD` 를
# 시도 — bootstrap.sh 의 superuser credential 과 환경 공유 가능.
AGENT_KB_PG_SUPERUSER=
AGENT_KB_PG_SUPERPASSWORD=
AGENT_KB_PG_SUPERUSER_HOST=
# M1+ — agent_kb_rw / agent_kb_ro role 비밀번호 (ADR-0021). bin/kb-pg-role-bootstrap.sh
# 의 default 'change_me_*' literal 은 fail-loud — 본 두 변수가 비어 있으면 bootstrap
# 스크립트가 명시 confirm 없으면 거부. 운영 환경에서는 vault / docker secret 권장.
# M2-b+ — KB Postgres 가 dual-write 의 필수 의존성인지 fail-loud 정책 toggle (ADR-0021
# Consequences + outside-voice REV-20260520-0007). 0 = optional (M0~M2-a default,
# init_memory() 가 graceful skip on _pg_available() False). 1 = required
# (init_memory() 가 fail-loud + dual-write 깨진 schema 위에서 시작 차단).
AGENT_KB_PG_REQUIRED=
# M2-b 진입 timestamp — bin/kb-dual-write-verify.sh --since 의 default. fail rate
# 분모를 "본 timestamp 이후 INSERT 된 row" 로 한정해 SLA 측정의 통계적 power 확보
# (outside-voice REV-20260520-0007 Section C Blocker). ISO8601 UTC. M2-b cycle
# 진입 시 자동 기록 또는 사용자 명시. 예: KB_DUAL_WRITE_START_TS=2026-06-01T00:00:00Z
KB_DUAL_WRITE_START_TS=
# Read backend 전환 (M0~M3: mysql, M4~M5: postgres):
AGENT_KB_READ_BACKEND=
# Dual-write toggle (M0~M1: 0, M2~M5 진입까지: 1, M5 후: 0):
AGENT_KB_DUAL_WRITE=
# Embedding pipeline (M3 backfill + 이후 incremental):
AGENT_KB_EMBEDDING_MODEL=
AGENT_KB_EMBEDDING_DIM=
AGENT_KB_EMBEDDING_BATCH_SIZE=
AGENT_KB_EMBEDDING_TIMEOUT_SEC=
AGENT_KB_EMBEDDING_MAX_ATTEMPTS=
# ANN index (M1 schema + M4 query — `ivfflat` 또는 `hnsw`):
AGENT_KB_ANN_INDEX_TYPE=
AGENT_KB_ANN_LISTS=
AGENT_KB_ANN_PROBE=
AGENT_KB_ANN_RECALL_TARGET=

# ============================================================================
# TASK-0094 Sprint 1 Phase 1 (ADR-0022) — MinIO S3-compat attachment storage
# ============================================================================
# 첨부 객체 (CSV/XLSX/PDF/이미지) 영속 저장. 사내망 다운로드만 signed URL 발급
# (외부 LLM 송신 금지 — BRIEFING D13). minio-init 부트스트랩이 bucket idempotent
# 생성 + lifecycle policy (D6 retention) + root credential 비활성화 + app
# 전용 access key 생성. App key rotation 은 D20 dual-key runbook (Phase 4).
#
# bootstrap-only credentials (minio-init 초기화 1회 후 비활성화):
MINIO_ROOT_USER=
# app-only credentials (rotation 대상 — D20 runbook):
# endpoint + bucket + signed URL TTL (사내망 다운로드 전용):
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=agent-attachments
MINIO_SIGNED_URL_TTL_SEC=900
# host port 매핑 (기본 9000/9001):
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# (옵션) MinIO browser console 리다이렉트 — 사내망 host 명시:
MINIO_BROWSER_REDIRECT_URL=

# Attachment size cap (BRIEFING D8): per-file 25 MB / per-conv 100 MB /
# per-account 1 GB. byte 단위.
ATTACHMENT_MAX_BYTES_PER_FILE=26214400
ATTACHMENT_MAX_BYTES_PER_CONV=104857600
ATTACHMENT_MAX_BYTES_PER_ACCOUNT=1073741824

# Audit masking HMAC key (BRIEFING D12) — tenant secret keyed HMAC of filename.
# rotation 시 기존 audit row 의 hash 는 변경하지 않으며, rotation 이후 row 만
# 신규 key 로 hash. rotation runbook 별도 (Sprint 1 후속 또는 운영 cycle).
ATTACHMENT_AUDIT_HMAC_KEY=

# Sandbox SQL guard (BRIEFING D14 — AST allowlist) 의 실행 제한:
# - max rows: SELECT 결과 row count cap (DoS 방지)
# - stmt timeout: 단일 SQL 실행 timeout (sec)
SANDBOX_SQL_MAX_ROWS=50000
SANDBOX_SQL_STMT_TIMEOUT_SEC=30

# ============================================================================
# TASK-0094 Sprint 1 Phase 10 (ADR-0023 + D15 + R-Claim4) — Sandbox MySQL users
# ============================================================================
# 4 user 분리 — maintainer (schema CREATE/DROP), writer (per-schema CREATE/ALTER/
# INSERT/SELECT — R-Claim4 최소권한), reader (SELECT only — D14 SQL 실행 user),
# cleanup (DROP SCHEMA only — reconciliation worker). R-Claim4 정합: GRANT ALL
# 금지, 권한은 maintenance path 가 exact backtick schema 명으로 부여.
ATTACHMENT_MAINTAINER_DB_USER=attachment_maintainer
ATTACHMENT_MAINTAINER_DB_PASSWORD=
ATTACHMENT_WRITER_DB_USER=attachment_writer
ATTACHMENT_WRITER_DB_PASSWORD=
ATTACHMENT_READER_DB_USER=attachment_reader
ATTACHMENT_READER_DB_PASSWORD=
ATTACHMENT_CLEANUP_DB_USER=attachment_cleanup
ATTACHMENT_CLEANUP_DB_PASSWORD=
